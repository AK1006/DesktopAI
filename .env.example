# ============================================
# AI Voice Assistant — Environment Variables
# ============================================
# Copy this file to `.env` and fill in your values.
# DO NOT commit the `.env` file to version control.
# ============================================

# Anthropic API Key (required for examples/anthropic_example.py)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (required for examples/openai_example.py)
OPENAI_API_KEY=your_openai_api_key_here

# WhatsApp phone number with country code (required for WhatsApp feature)
# Example: +11234567890
WHATSAPP_PHONE_NUMBER=+1234567890
